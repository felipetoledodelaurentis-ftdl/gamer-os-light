# ---------------------------------------------------------------------------
# Utilitarios
# ---------------------------------------------------------------------------
def run(cmd, timeout=3):
    """Executa um comando e devolve a saida (ou '' se falhar)."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=timeout).stdout.strip()
    except Exception:
        return ""


def launch(cmd):
    """Abre um programa sem travar a Central."""
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return True
    except Exception:
        return False


def read(path, default=""):
    try:
        return Path(path).read_text().strip()
    except Exception:
        return default


def load_settings():
    data = {}
    for line in read(SETTINGS).splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            data[k.strip()] = v.strip()
    return data


def save_settings(data):
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text("".join(f"{k}={v}\n" for k, v in data.items()))


# ---------------------------------------------------------------------------
# Leitura de hardware
# ---------------------------------------------------------------------------
class GPU:
    """Le uso, temperatura e memoria da placa de video (AMD, NVIDIA ou Intel)."""

    def __init__(self):
        self.kind = None
        self.name = "Não detectada"
        self.card = None
        self.driver = ""
        self._detect()

    def _detect(self):
        if shutil.which("nvidia-smi"):
            name = run(["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"])
            if name:
                self.kind, self.name, self.driver = "nvidia", name.splitlines()[0], "nvidia"
                return
        for dev in sorted(glob.glob("/sys/class/drm/card[0-9]*/device")):
            vendor = read(f"{dev}/vendor")
            if vendor == "0x1002" and os.path.exists(f"{dev}/gpu_busy_percent"):
                self.kind, self.card = "amd", dev
                break
            if vendor == "0x8086" and self.kind is None:
                self.kind, self.card = "intel", dev
        names = gpu_names()
        if names:
            self.name = names[0][0]
            self.driver = names[0][1]
            if self.kind == "amd":
                for n, d in names:
                    if "AMD" in n or "ATI" in n or "Radeon" in n:
                        self.name, self.driver = n, d

    def stats(self):
        """Devolve (uso %, temperatura C, vram usada MB, vram total MB)."""
        try:
            if self.kind == "nvidia":
                out = run(["nvidia-smi",
                           "--query-gpu=utilization.gpu,temperature.gpu,memory.used,memory.total",
                           "--format=csv,noheader,nounits"])
                u, t, mu, mt = [float(x) for x in out.splitlines()[0].split(",")]
                return u, t, mu, mt
            if self.kind == "amd":
                d = self.card
                u = float(read(f"{d}/gpu_busy_percent", "0"))
                mu = float(read(f"{d}/mem_info_vram_used", "0")) / 1048576
                mt = float(read(f"{d}/mem_info_vram_total", "0")) / 1048576
                t = None
                for h in glob.glob(f"{d}/hwmon/hwmon*/temp1_input"):
                    t = float(read(h, "0")) / 1000
                return u, t, mu, mt
            if self.kind == "intel":
                for h in glob.glob(f"{self.card}/hwmon/hwmon*/temp1_input"):
                    return None, float(read(h, "0")) / 1000, None, None
        except Exception:
            pass
        return None, None, None, None


def gpu_names():
    """Lista (nome, driver em uso) de cada placa de video via lspci."""
    out = run(["lspci", "-k"])
    result, current = [], None
    for line in out.splitlines():
        if re.search(r"VGA compatible|3D controller|Display controller", line):
            current = line.split(": ", 1)[-1]
            current = re.sub(r"\s*\(rev .*\)$", "", current)
            result.append([current, ""])
        elif current and "Kernel driver in use" in line:
            result[-1][1] = line.split(":", 1)[1].strip()
            current = None
    return [tuple(r) for r in result]


def cpu_temp():
    try:
        temps = psutil.sensors_temperatures()
    except Exception:
        return None
    for key in ("k10temp", "zenpower", "coretemp", "cpu_thermal", "acpitz"):
        for entry in temps.get(key, []):
            if key != "coretemp" or entry.label.startswith("Package"):
                return entry.current
    return None


def cpu_name():
    for line in read("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            return re.sub(r"\s+", " ", line.split(":", 1)[1]).strip()
    return platform.processor() or "Processador"


def gamepads():
    """Controles conectados (lidos de /proc/bus/input/devices)."""
    found = []
    for block in read("/proc/bus/input/devices").split("\n\n"):
        name = re.search(r'N: Name="(.*)"', block)
        handlers = re.search(r"H: Handlers=(.*)", block)
        if name and handlers and re.search(r"\bjs\d+", handlers.group(1)):
            n = name.group(1)
            low = n.lower()
            if any(k in low for k in ("xbox", "microsoft", "x-box")):
                kind = "Xbox"
            elif any(k in low for k in ("sony", "dualsense", "dualshock", "playstation", "wireless controller")):
                kind = "PlayStation"
            else:
                kind = "Controle"
            if n not in [f[0] for f in found]:
                found.append((n, kind))
    return found


# ---------------------------------------------------------------------------
# Componentes visuais
# ---------------------------------------------------------------------------
class Sparkline(QWidget):
    """Grafico pequeno com o historico dos ultimos segundos."""

    def __init__(self, color, maximum=100.0, parent=None):
        super().__init__(parent)
        self.color = QColor(color)
        self.maximum = maximum
        self.values = deque([0.0] * 60, maxlen=60)
        self.setMinimumHeight(56)

    def push(self, value):
        self.values.append(max(0.0, float(value or 0)))
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        w, h = self.width(), self.height()
        n = len(self.values)
        top = max(self.maximum, max(self.values) or 1)
        pts = [QPointF(i * w / (n - 1), h - 2 - (v / top) * (h - 6))
               for i, v in enumerate(self.values)]
        path = QPainterPath(pts[0])
        for pt in pts[1:]:
            path.lineTo(pt)
        fill = QPainterPath(path)
        fill.lineTo(w, h)
        fill.lineTo(0, h)
        fill.closeSubpath()
        grad = QLinearGradient(0, 0, 0, h)
        c1 = QColor(self.color)
        c1.setAlpha(110)
        c2 = QColor(self.color)
        c2.setAlpha(0)
        grad.setColorAt(0, c1)
        grad.setColorAt(1, c2)
        p.fillPath(fill, grad)
        p.setPen(QPen(self.color, 2))
        p.drawPath(path)


class Ring(QWidget):
    """Medidor circular (porcentagem)."""

    def __init__(self, color, parent=None):
        super().__init__(parent)
        self.color = QColor(color)
        self.value = 0.0
        self.setFixedSize(76, 76)

    def set(self, value):
        self.value = max(0.0, min(100.0, float(value or 0)))
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(6, 6, self.width() - 12, self.height() - 12)
        p.setPen(QPen(QColor("#262A50"), 8, Qt.SolidLine, Qt.RoundCap))
        p.drawArc(r, 0, 360 * 16)
        p.setPen(QPen(self.color, 8, Qt.SolidLine, Qt.RoundCap))
        p.drawArc(r, 90 * 16, int(-self.value * 3.6 * 16))
        p.setPen(QColor(TEXT))
        f = QFont()
        f.setPointSize(11)
        f.setBold(True)
        p.setFont(f)
        p.drawText(r, Qt.AlignCenter, f"{self.value:.0f}%")


class Toggle(QCheckBox):
    """Chave liga/desliga no estilo do Windows 11."""

    def __init__(self, text, parent=None):
        super().__init__(text, parent)
        self.setCursor(Qt.PointingHandCursor)
        self.setMinimumHeight(30)

    def sizeHint(self):
        sh = super().sizeHint()
        return sh.expandedTo(sh.__class__(sh.width() + 30, 30))

    def hitButton(self, pos):
        return self.rect().contains(pos)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        h = 24
        y = (self.height() - h) / 2
        track = QRectF(0, y, 46, h)
        on = self.isChecked()
        p.setPen(Qt.NoPen)
        p.setBrush(QColor(CYAN if on else "#2A2E52"))
        p.drawRoundedRect(track, h / 2, h / 2)
        p.setBrush(QColor("#060814" if on else "#C9CCE8"))
        knob_x = 46 - h + 4 if on else 4
        p.drawEllipse(QRectF(knob_x, y + 4, h - 8, h - 8))
        p.setPen(QColor(TEXT))
        f = self.font()
        f.setPointSize(11)
        p.setFont(f)
        p.drawText(QRectF(58, 0, self.width() - 58, self.height()),
                   Qt.AlignVCenter | Qt.AlignLeft, self.text())


def card(parent=None):
    f = QFrame(parent)
    f.setObjectName("card")
    return f


def label(text, name=None, wrap=False):
    lb = QLabel(text)
    if name:
        lb.setObjectName(name)
    lb.setWordWrap(wrap)
    return lb


def button(text, name="action", slot=None):
    b = QPushButton(text)
    b.setObjectName(name)
    b.setCursor(Qt.PointingHandCursor)
    if slot:
        b.clicked.connect(slot)
    return b


class StatCard(QFrame):
    """Cartao com titulo, valor grande, detalhe, medidor e grafico."""

    def __init__(self, title, color, show_ring=True):
        super().__init__()
        self.setObjectName("card")
        lay = QVBoxLayout(self)
        lay.setContentsMargins(18, 16, 18, 14)
        top = QHBoxLayout()
        texts = QVBoxLayout()
        self.title = label(title.upper(), "cardtitle")
        self.value = label("--", "bigvalue")
        self.detail = label("", "hint", wrap=True)
        texts.addWidget(self.title)
        texts.addWidget(self.value)
        texts.addWidget(self.detail)
        top.addLayout(texts, 1)
        self.ring = Ring(color) if show_ring else None
        if self.ring:
            top.addWidget(self.ring, 0, Qt.AlignTop)
        lay.addLayout(top)
        self.spark = Sparkline(color)
        lay.addWidget(self.spark)

    def update_values(self, value_text, detail, percent):
        self.value.setText(value_text)
        self.detail.setText(detail)
        if self.ring is not None:
            self.ring.setVisible(percent is not None)
            if percent is not None:
                self.ring.set(percent)
        self.spark.push(percent or 0)


